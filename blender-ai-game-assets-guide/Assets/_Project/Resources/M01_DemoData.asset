  - id: UI_001
    speaker: 
    time: 0
    text: "1950\uB144 8\uC6D4, \uACBD\uBD81 \uCE60\uACE1 \uB2E4\uBD80\uB3D9"
    seconds: 4
    caption: 1
    note: "\uC2DC\uC791 \uC790\uB9C9"
  - id: VO_Kim_000
    speaker: "\uAE40\uB355\uB9CC"
    time: 8
    text: "\uC2E0\uBCD1\uB4E4 \uB0B4\uB824\uB77C. \uACE0\uAC1C \uC219\uC774\uACE0 \uB530\uB77C\uC624\uB77C\uC6B0."
    seconds: 3.5
    caption: 0
    note: "\uD3C9\uC548\uB3C4 \uB9D0\uC528, \uAC10\uC218 \uD544\uC694"
  - id: VO_Kim_001
    speaker: "\uAE40\uB355\uB9CC"
    time: 20
    text: "\uC870\uBA85\uD0C4 \uB728\uBA74 \uACE0\uAC1C \uC219\uC774\uB77C. \uBC1D\uC744 \uB54C \uC3D8\uACE0, \uC5B4\uB450\uC6B8 \uB54C \uC6C0\uC9C1\uC774\uB77C."
    seconds: 5
    caption: 0
    note: 
  - id: VO_Kim_002
    speaker: "\uAE40\uB355\uB9CC"
    time: 28
    text: "\uC800\uAE30, \uB2A5\uC120 \uC544\uB798! \uB458\uC774\uB2E4!"
    seconds: 3
    caption: 0
    note: 
  - id: VO_Kim_003
    speaker: "\uAE40\uB355\uB9CC"
    time: 40
    text: "\uC628\uB2E4! \uAC01\uC790 \uC790\uB9AC \uC9C0\uD0A4\uB77C!"
    seconds: 3
    caption: 0
    note: 
  - id: VO_Enemy_001
    speaker: "\uBD81\uD55C\uAD70"
    time: 41
    text: "\uC55E\uC73C\uB85C!"
    seconds: 2
    caption: 0
    note: "\uACE0\uC99D \uD655\uC778 \uD544\uC694"
  - id: VO_Park_001
    speaker: "\uBC15\uC6A9\uD314"
    time: 43
    text: "\uC628\uB2E4, \uC628\uB2E4\uC789!"
    seconds: 3
    caption: 0
    note: "\uC804\uB77C\uB3C4 \uB9D0\uC528, \uAC10\uC218 \uD544\uC694"
  - id: VO_Enemy_002
    speaker: "\uBD81\uD55C\uAD70"
    time: 60
    text: "\uB3CC\uACA9!"
    seconds: 2
    caption: 0
    note: "\uACE0\uC99D \uD655\uC778 \uD544\uC694"
  - id: VO_Park_002
    speaker: "\uBC15\uC6A9\uD314"
    time: 64
    text: "\uC11D\uAD6C\uC57C, \uD0C4\uC57D \uC0C1\uC790 \uB4A4\uC5D0 \uC788\uB2F9\uAED8!"
    seconds: 3.5
    caption: 0
    note: 
  - id: VO_Park_003
    speaker: "\uBC15\uC6A9\uD314"
    time: 90
    text: "\uB9CC\uC218\uC57C? \u2026\uB9CC\uC218\uC57C."
    seconds: 5
    caption: 0
    note: "\uB300\uB2F5 \uC5C6\uC74C. \uC0AC\uB78C \uBAA9\uC18C\uB9AC"
  - id: VO_Kim_004
    speaker: "\uAE40\uB355\uB9CC"
    time: 110
    text: "\uC804\uCC28\uB2E4! \uC11D\uAD6C\uC57C, \uB454\uB355\uC73C\uB85C \uAC00\uB77C! \uC606\uAD6C\uB9AC\uB97C \uC3D8\uB77C\uC6B0!"
    seconds: 5
    caption: 0
    note: "\uC0AC\uB78C \uBAA9\uC18C\uB9AC"
  - id: VO_Taeseok_001
    speaker: "\uC724\uD0DC\uC11D"
    time: 152
    text: "\uD3EC\uD56D\uC5D0\uC11C \uC654\uC2B5\uB2C8\uB2E4."
    seconds: 3
    caption: 0
    note: "\uC573\uB41C \uBAA9\uC18C\uB9AC. \uC0AC\uB78C \uBAA9\uC18C\uB9AC \uAD8C\uC7A5"
  - id: VO_Seokgu_N01
    speaker: "\uC11D\uAD6C (\uB0B4\uB808\uC774\uC158)"
    time: 155
    text: "\uC5EC\uBCF4, \uB0A0\uC774 \uBC1D\uC558\uC18C. \uC624\uB298 \uC544\uCE68 \uD559\uC0DD\uB4E4\uC774 \uC654\uB294\uB370, \uADF8\uC911 \uD558\uB098\uB294 \uD3EC\uD56D\uC5D0\uC11C \uC654\uB2E4 \uD558\uC624."
    seconds: 6.5
    caption: 0
    note: 
  - id: VO_Seokgu_N02
    speaker: "\uC11D\uAD6C (\uB0B4\uB808\uC774\uC158)"
    time: 162
    text: "\uC774\uB984\uC774 \uD0DC\uC11D\uC774\uB77C \uD588\uC18C. \uB0B4 \uB9C9\uB0C7\uB3D9\uC0DD\uBED8\uC774\uC624."
    seconds: 3.8
    caption: 0
    note: 
  - id: VO_Seokgu_N03
    speaker: "\uC11D\uAD6C (\uB0B4\uB808\uC774\uC158)"
    time: 166
    text: "\uB9CC\uC218\uB294 \uB05D\uB0B4 \uC544\uCE68\uC744 \uBABB \uBD24\uC18C."
    seconds: 3.8
    caption: 0
    note: "\uC0AC\uB78C \uBAA9\uC18C\uB9AC"
